VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
# REMOVED (privacy/security audit): a client-side Gemini key used to live here
# and was called directly from the browser by several frontend files
# (dyslexia/ASD AI features). A VITE_-prefixed var is compiled into the public
# JS bundle, so that key was extractable by anyone who opened devtools — a
# real billing/abuse exposure, with no auth, rate limiting, or server-side
# visibility on those calls. All Gemini calls now go through the backend's
# authenticated, rate-limited proxy (backend/routers/ai_proxy_router.py) via
# src/lib/geminiProxyClient.js. Do NOT re-add a VITE_GEMINI_API_KEY or call
# generativelanguage.googleapis.com directly from frontend code.

# --- Backend (FastAPI) — plain env vars, no VITE_ prefix, never bundled into the frontend ---
# Same Supabase project as above; backend/auth.py uses these (anon key only, not a secret)
# to validate the frontend's Supabase session token on every request.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
# Server-side Gemini key — used by the agent orchestrator
# (backend/services/agent_service.py), the OCD AI-assist endpoints
# (backend/services/ai_service.py), and the general-purpose AI proxy
# (backend/routers/ai_proxy_router.py) that now serves every frontend AI
# feature. Required for any of those to do more than their deterministic
# fallback. This is the ONLY place a Gemini key should exist.
GEMINI_API_KEY=[GCP_API_KEY]
# Optional: enables real account-deletion via Supabase's Admin API from
# DELETE /api/privacy/data (backend/routers/privacy_router.py). Without it,
# that endpoint still deletes all of the user's NeuroBridge application data,
# it just can't also remove their Supabase sign-in account. Treat this key
# like a root credential — it bypasses RLS and auth entirely; never expose it
# to the frontend or log it.
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Per-user/hour limit on the general AI proxy (dyslexia/ASD features) — same
# purpose as OCD_AI_RATE_LIMIT_PER_HOUR below, for the new shared endpoint.
# AI_PROXY_RATE_LIMIT_PER_HOUR=120
# Optional: Postgres/Supabase connection string. Falls back to a local SQLite file if unset.
# DATABASE_URL=postgresql://...
# Comma-separated list of allowed frontend origins for CORS. Set this explicitly in production
# (e.g. your Vercel domain) — the code no longer allows "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Which Gemini model the orchestrator uses.
# GEMINI_MODEL_NAME=gemini-3.6-flash
# OCR model override. Use gemini-3.6-flash only if it is enabled for your API key;
# the frontend falls back to gemini-2.5-flash when the requested model returns 404.
# GEMINI_OCR_MODEL=gemini-2.5-flash

# --- Agent execution tuning (all optional; sane defaults if unset) ---
# Max Gemini <-> tool round trips per message before the agent gives up and
# returns a structured FAILED state instead of looping forever.
# AGENT_MAX_STEPS=4
# Per-LLM-call timeout, and the one-retry policy only applies to transient
# errors (timeout/network/upstream) within this budget.
# AGENT_LLM_TIMEOUT_MS=15000
# Per-tool-call timeout (a thread-pool safety net — real tools are simple sync
# DB calls today, this exists for when a slower one is added later).
# AGENT_TOOL_TIMEOUT_MS=5000
# How long the short-TTL user-preferences cache (get_user_learnings) stays warm.
# AGENT_CACHE_TTL_SECONDS=20
# Messages/hour for real (non-demo) authenticated accounts — demo mode has its
# own fixed, lower limit (20/hr) since it has no real credential behind it.
# AGENT_REAL_RATE_LIMIT_PER_HOUR=60

# --- Bri Agent V2 (docs/BRI_AGENT_UPGRADE.md) ---
# V2 = follow-up understanding, conversation state, action policy, verification.
# Falls back to the V1 agent on any V2 fault; set false to run V1 only.
# BRI_AGENT_V2_ENABLED=true
# BRI_AGENT_FALLBACK_ENABLED=true
# Optional real-time voice via Gemini Live (needs GEMINI_API_KEY; ephemeral tokens,
# key never sent to the browser). Off by default; chat + voice input always remain.
# GEMINI_LIVE_ENABLED=false
# GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_LIVE_SESSION_MINUTES=10
# GEMINI_LIVE_SESSIONS_PER_HOUR=6
# Per-user/hour limit on the OCD endpoints that each trigger a direct Gemini call
# outside the agent chat loop (create hierarchy / ERP session / journal entry) —
# without this a user could bypass AGENT_REAL_RATE_LIMIT_PER_HOUR entirely.
# OCD_AI_RATE_LIMIT_PER_HOUR=40

# --- Adaptive Engine feature flags (default OFF) ---
# See backend/adaptive/engine/featureFlags.js for the staged activation plan.
# Stage A (runtime): live decision path in the app (decides only; no
# auto-execution). Activated in production via .env.production.
# VITE_NEUROBRIDGE_ADAPTIVE_RUNTIME=false
# Stage B (reflection): learned signals feeding Tier 9. Not yet activated.
# VITE_NEUROBRIDGE_ADAPTIVE_REFLECTION=false
# Stage C (uiExecution): UI executor applying actions to live rendering.
# Not yet activated — the executor integration review is still pending.
# VITE_NEUROBRIDGE_ADAPTIVE_UI_EXECUTION=false

# --- Google platform (see docs/GOOGLE_ARCHITECTURE.md). All optional; app degrades gracefully. ---
# Frontend Firebase web config (public identifiers, safe in the bundle). Enables Google Sign-In,
# App Check and Analytics.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_APPCHECK_SITE_KEY=
# Backend
# GOOGLE_CLOUD_PROJECT=
# FIREBASE_PROJECT_ID=
# GOOGLE_GENAI_USE_VERTEXAI=true     # use Vertex AI with ADC/service account instead of GEMINI_API_KEY
# VERTEX_AI_LOCATION=us-central1
# GEMINI_PRO_MODEL=                  # document analysis model (default gemini-2.5-pro)
# GEMINI_EMBEDDING_MODEL=            # default gemini-embedding-001
# GCS_BUCKET=
# BIGQUERY_DATASET=
# FIREBASE_APP_CHECK_MODE=off        # off | monitor | enforce
# GCP_SECRET_NAMES=                  # e.g. GEMINI_API_KEY,SUPABASE_ANON_KEY (loaded from Secret Manager at boot)
# LOG_FORMAT=json                    # automatic on Cloud Run
