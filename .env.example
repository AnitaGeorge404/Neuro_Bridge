
# ============================================================
# NEUROBRIDGE — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in required values.
# Never commit .env or real credentials to Git.
# Frontend and backend must use the SAME Supabase project.

# ============================================================
# 1. SUPABASE — FRONTEND
# ============================================================
# Public values compiled into the Vite browser bundle.
# Never use a service-role or secret key here.

VITE_SUPABASE_URL=https://bgtbdywntzodxprsmtmx.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# ============================================================
# 2. SUPABASE — BACKEND
# ============================================================

SUPABASE_URL=https://bgtbdywntzodxprsmtmx.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# PostgreSQL connection string.
# Use the connection URI supplied by Supabase.
# URL-encode reserved characters in the database password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Optional privileged key for account deletion.
# Never expose this to the frontend.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ============================================================
# 3. GOOGLE GEMINI / VERTEX AI
# ============================================================

# Server-side only. Never prefix with VITE_.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Production uses Vertex AI via Cloud Run credentials.
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_AI_LOCATION=europe-west2

# Optional model overrides.
# GEMINI_MODEL_NAME=gemini-3.6-flash
# GEMINI_PRO_MODEL=gemini-2.5-pro
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ============================================================
# 4. FIREBASE HOSTING / GOOGLE CLOUD
# ============================================================

GOOGLE_CLOUD_PROJECT=neuro-bridge-4339e
FIREBASE_PROJECT_ID=neuro-bridge-4339e

GCS_BUCKET=neuro-bridge-4339e-neurobridge-docs
BIGQUERY_DATASET=neurobridge_analytics

# Frontend Firebase configuration.
# Obtain these values from Firebase Console > Project Settings.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# App Check: off | monitor | enforce
FIREBASE_APP_CHECK_MODE=monitor

# ============================================================
# 5. API / CORS
# ============================================================

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://neuro-bridge-4339e.web.app,https://neuro-bridge-4339e.firebaseapp.com,https://neuro-bridge-olive.vercel.app

# Set only if required by the frontend/backend configuration.
# CLOUD_RUN_URL=https://neurobridge-api-485922437097.europe-west2.run.app

# ============================================================
# 6. GOOGLE SECRET MANAGER
# ============================================================

# The backend loads these secrets at startup.
# Ensure the corresponding secrets exist in Google Cloud.
# In production, secrets should not be duplicated as plain env vars.

GCP_SECRET_NAMES=SUPABASE_ANON_KEY,DATABASE_URL,GEMINI_API_KEY

# ============================================================
# 7. AGENT EXECUTION
# ============================================================

AGENT_MAX_STEPS=4
AGENT_LLM_TIMEOUT_MS=15000
AGENT_TOOL_TIMEOUT_MS=5000
AGENT_CACHE_TTL_SECONDS=20

AGENT_REAL_RATE_LIMIT_PER_HOUR=60
AI_PROXY_RATE_LIMIT_PER_HOUR=120
OCD_AI_RATE_LIMIT_PER_HOUR=40

# ============================================================
# 8. BRI AGENT V2
# ============================================================

BRI_AGENT_V2_ENABLED=true
BRI_AGENT_FALLBACK_ENABLED=true

# Optional Gemini Live voice.
GEMINI_LIVE_ENABLED=false
# GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_SESSION_MINUTES=10
GEMINI_LIVE_SESSIONS_PER_HOUR=6

# ============================================================
# 9. ADAPTIVE ENGINE FEATURE FLAGS
# ============================================================

# Stage A: Live adaptation decision runtime.
# Decisions only; does not automatically execute UI changes.
VITE_NEUROBRIDGE_ADAPTIVE_RUNTIME=false

# Stage B: Reflection signals used by adaptive learning.
VITE_NEUROBRIDGE_ADAPTIVE_REFLECTION=false

# Stage C: Automatic UI adaptation execution.
VITE_NEUROBRIDGE_ADAPTIVE_UI_EXECUTION=false

# Enable stages only after validating their integrations.

# ============================================================
# 10. LOGGING
# ============================================================

LOG_FORMAT=json

# ============================================================
# SECURITY NOTES
# ============================================================
# 1. Never add VITE_GEMINI_API_KEY.
# 2. Never expose Supabase secret/service-role keys in Vite.
# 3. All frontend Gemini requests must use the backend proxy.
# 4. Keep database credentials server-side.
# 5. Enable and verify appropriate Supabase RLS policies.
# 6. Do not commit real .env files.
# 7. Use Google Secret Manager for production secrets.
